{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|assets/|sitemap\\.xml|robots\\.txt|google5c623909cef418f0\\.html|manifest\\.json|sw\\.js|favicon\\.svg|logo\\.png|logo_silver_v2\\.png|hero\\.png|icons\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}